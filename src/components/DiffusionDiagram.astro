---
import Diagram from './Diagram.astro';
---
<Diagram
  label="Diffusion — Forward and Reverse (2020)"
  ariaLabel="Diagram showing two processes: the forward process used in training adds Gaussian noise to a real image step by step until it becomes pure noise. The reverse process used at inference time starts from pure noise and iteratively removes noise, guided by a learned score function, until a generated image emerges."
>
  <div class="diff">
    <div class="diff-row diff-forward">
      <div class="diff-label">Training<br/><span class="diff-sublabel">forward process</span></div>
      <div class="diff-steps">
        <div class="diff-node diff-real">Real Image</div>
        <div class="diff-arrow diff-arrow-fwd">+noise →</div>
        <div class="diff-node diff-mid1">Noisy</div>
        <div class="diff-arrow diff-arrow-fwd">+noise →</div>
        <div class="diff-node diff-mid2">Noisier</div>
        <div class="diff-arrow diff-arrow-fwd">+noise →</div>
        <div class="diff-node diff-noise">Pure Noise</div>
      </div>
    </div>

    <div class="diff-divider"></div>

    <div class="diff-row diff-reverse">
      <div class="diff-label">Inference<br/><span class="diff-sublabel">reverse process</span></div>
      <div class="diff-steps">
        <div class="diff-node diff-noise">Pure Noise</div>
        <div class="diff-arrow diff-arrow-rev">−noise →</div>
        <div class="diff-node diff-mid2">Less Noisy</div>
        <div class="diff-arrow diff-arrow-rev">−noise →</div>
        <div class="diff-node diff-mid1">Clearer</div>
        <div class="diff-arrow diff-arrow-rev">−noise →</div>
        <div class="diff-node diff-gen">Generated Image</div>
      </div>
    </div>
  </div>
</Diagram>

<style>
  .diff {
    display: flex;
    flex-direction: column;
    gap: 0;
    padding: clamp(0.85rem, 3vw, 1.35rem);
    font-family: var(--font-mono, 'Courier New', monospace);
    font-size: clamp(0.68rem, 1.8vw, 0.76rem);
  }

  .diff-row {
    display: grid;
    grid-template-columns: minmax(4.75rem, 0.2fr) 1fr;
    align-items: center;
    gap: 0.8rem;
    padding: 0.8rem 0;
  }

  .diff-label {
    font-size: 0.72em;
    color: #8a8a8a;
    text-align: right;
    line-height: 1.35;
  }

  .diff-sublabel {
    color: #666;
    font-style: italic;
  }

  .diff-steps {
    display: grid;
    grid-template-columns: minmax(5.25rem, 1fr) auto minmax(4.75rem, 1fr) auto minmax(4.75rem, 1fr) auto minmax(6.25rem, 1fr);
    align-items: stretch;
    gap: 0.3rem;
  }

  .diff-node {
    border: 1px solid #2a2a2a;
    padding: 0.55rem 0.6rem;
    min-height: 3rem;
    display: grid;
    place-items: center;
    background: #0d0d0d;
    color: #a0a0a0;
    text-align: center;
    font-size: 0.9em;
    letter-spacing: 0.025em;
    line-height: 1.2;
  }

  .diff-real  { border-color: #555; color: #d4d4d4; }
  .diff-gen   { border-color: #3bceac; background: #0a1a17; color: #3bceac; }
  .diff-noise { border-color: #333; color: #777; }
  .diff-mid1  { border-color: #333; }
  .diff-mid2  { border-color: #333; }

  .diff-arrow {
    color: #666;
    font-size: 0.72em;
    letter-spacing: -0.02em;
    white-space: nowrap;
    padding: 0 0.1rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .diff-arrow-fwd { color: #777; }
  .diff-arrow-rev { color: #3bceacc0; }

  .diff-divider {
    height: 1px;
    background: #222;
    margin: 0 0.5rem;
  }

  @media (max-width: 720px) {
    .diff {
      padding: 0.9rem;
      font-size: 0.78rem;
    }

    .diff-row {
      grid-template-columns: 1fr;
      gap: 0.55rem;
      padding: 0.9rem 0;
    }

    .diff-label {
      text-align: left;
      padding-left: 0.15rem;
      color: #a0a0a0;
    }

    .diff-steps {
      grid-template-columns: 1fr;
      gap: 0.25rem;
    }

    .diff-node {
      min-height: auto;
      padding: 0.8rem;
    }

    .diff-arrow {
      min-height: 1.2rem;
      padding: 0;
      color: transparent;
      font-size: 0;
    }

    .diff-arrow::before {
      content: '↓';
      color: #666;
      font-size: 1rem;
      line-height: 1;
    }

    .diff-arrow-rev::before {
      color: #3bceacc0;
    }
  }
</style>
