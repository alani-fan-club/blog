---
---
<div class="diagram" role="img" aria-label="Timeline showing streaming execution: the harness dispatches tool A as soon as the LLM emits it, while the LLM continues generating tool B. Results return before the LLM finishes writing.">
  <div class="diagram-label">Streaming Execution</div>
  <div class="dg-stream" aria-hidden="true">
    <div class="dg-stream-time" style="grid-column: 1 / -1">
      <span>time</span><span class="dg-stream-line"></span><span class="dg-stream-arrow"></span>
    </div>

    <div class="dg-stream-lbl" style="grid-column: 1; grid-row: 2">LLM stream</div>
    <div class="dg-seg dg-seg--dim" style="grid-column: 2; grid-row: 2">text</div>
    <div class="dg-seg dg-seg--tool" style="grid-column: 3; grid-row: 2">tool A ✓</div>
    <div class="dg-seg dg-seg--dim" style="grid-column: 4; grid-row: 2">more text</div>
    <div class="dg-seg dg-seg--tool" style="grid-column: 5; grid-row: 2">tool B ✓</div>
    <div class="dg-seg dg-seg--dim" style="grid-column: 6; grid-row: 2">text</div>

    <div class="dg-stream-conn" style="grid-column: 3; grid-row: 3"></div>
    <div class="dg-stream-conn" style="grid-column: 5; grid-row: 3"></div>

    <div class="dg-stream-lbl" style="grid-column: 1; grid-row: 4">Harness</div>
    <div class="dg-stream-txt" style="grid-column: 3; grid-row: 4">dispatch A</div>
    <div class="dg-stream-txt dg-stream-txt--dim" style="grid-column: 3; grid-row: 5">A starts ...</div>
    <div class="dg-stream-txt dg-stream-txt--done" style="grid-column: 3; grid-row: 6">A done ✓</div>

    <div class="dg-stream-txt" style="grid-column: 5; grid-row: 4">dispatch B</div>
    <div class="dg-stream-txt dg-stream-txt--dim" style="grid-column: 5; grid-row: 5">B starts ...</div>

    <div class="dg-stream-conn" style="grid-column: 5; grid-row: 6"></div>

    <div class="dg-stream-note" style="grid-column: 4 / 7; grid-row: 7">results returning</div>
    <div class="dg-stream-note" style="grid-column: 4 / 7; grid-row: 8">(LLM still writing)</div>
  </div>
</div>
