---
interface Props {
  label: string;
  title: string;
  ariaLabel?: string;
}

const { label, title, ariaLabel } = Astro.props;
---
<div class="alert" role="note" aria-label={ariaLabel || `${label}: ${title}`}>
  <div class="alert-label">{label}</div>
  <div class="alert-title">{title}</div>
  <div class="alert-desc"><slot /></div>
</div>
