---
// SamplerWidget.astro — Interactive visualization for LLM samplers
export interface Props {
  /** The active sampler mode to demonstrate */
  mode: 'temperature' | 'top-k' | 'top-p' | 'min-p' | 'all';
  /** The base logit distribution to use */
  dataset?: 'confident' | 'uncertain';
}

const { mode = 'all', dataset = 'uncertain' } = Astro.props;
---

<sampler-widget data-mode={mode} data-dataset={dataset}>
  <div class="sampler-container">
    <div class="sampler-header">
      <span class="prompt-text">
        {dataset === 'confident' 
          ? "Prompt: \"What is your name?\" Model:" 
          : "Prompt: \"Looking out the window, she saw...\" Model:"}
      </span>
    </div>
    
    <div class="sampler-layout">
      <div class="controls-panel">
        <div class="control-group" data-param="temperature">
          <label>
            <span>Temperature (T)</span>
            <span class="val-display" id="val-t">1.00</span>
          </label>
          <input type="range" id="slider-t" min="0.1" max="3.0" step="0.05" value="1.0">
        </div>
        
        <div class="control-group" data-param="top-k">
          <label>
            <span>Top-K</span>
            <span class="val-display" id="val-k">50</span>
          </label>
          <input type="range" id="slider-k" min="1" max="50" step="1" value="50">
        </div>

        <div class="control-group" data-param="top-p">
          <label>
            <span>Top-P (Nucleus)</span>
            <span class="val-display" id="val-p">1.00</span>
          </label>
          <input type="range" id="slider-p" min="0.01" max="1.0" step="0.01" value="1.0">
        </div>

        <div class="control-group" data-param="min-p">
          <label>
            <span>Min-P</span>
            <span class="val-display" id="val-minp">0.00</span>
          </label>
          <input type="range" id="slider-minp" min="0.0" max="0.5" step="0.01" value="0.0">
        </div>
        
        <div class="stats-panel">
          <div class="stat-row">
            <span>Tokens Kept:</span>
            <span id="stat-kept">50/50</span>
          </div>
          <div class="stat-row">
            <span>Mass Kept:</span>
            <span id="stat-mass">100.0%</span>
          </div>
        </div>
      </div>

      <div class="chart-panel">
        <div class="chart-header">
          <div class="col-token">TOKEN</div>
          <div class="col-prob">PROBABILITY</div>
        </div>
        <div class="chart-bars" id="chart-bars">
          <!-- Bars injected via JS -->
        </div>
      </div>
    </div>
  </div>
</sampler-widget>

<style>
  sampler-widget {
    display: block;
    margin: 2rem 0;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    background: #050505;
    border: 1px solid #333;
    color: #e0e0e0;
  }

  .sampler-container {
    display: flex;
    flex-direction: column;
  }

  .sampler-header {
    padding: 0.75rem 1rem;
    border-bottom: 1px dashed #333;
    font-size: 0.85rem;
    color: #888;
  }
  
  .prompt-text {
    color: #3bceac; /* Cyan accent for context */
  }

  .sampler-layout {
    display: grid;
    grid-template-columns: 250px 1fr;
  }

  @media (max-width: 768px) {
    .sampler-layout {
      grid-template-columns: 1fr;
    }
  }

  .controls-panel {
    padding: 1.5rem 1rem;
    border-right: 1px dashed #333;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    background: #0a0a0a;
  }
  
  @media (max-width: 768px) {
    .controls-panel {
      border-right: none;
      border-bottom: 1px dashed #333;
    }
  }

  .control-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  
  .control-group.disabled {
    opacity: 0.3;
    pointer-events: none;
    filter: grayscale(100%);
  }
  
  .control-group label {
    display: flex;
    justify-content: space-between;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  
  .val-display {
    color: #e0303e; /* Cherry-red accent */
    font-weight: bold;
  }

  input[type="range"] {
    -webkit-appearance: none;
    width: 100%;
    height: 4px;
    background: #333;
    outline: none;
  }

  input[type="range"]::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 12px;
    height: 12px;
    background: #e0303e;
    cursor: pointer;
    border-radius: 0; /* Square thumb for brutalist feel */
  }

  .stats-panel {
    margin-top: auto;
    padding-top: 1rem;
    border-top: 1px dotted #333;
    font-size: 0.75rem;
    color: #aaa;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  
  .stat-row {
    display: flex;
    justify-content: space-between;
  }
  .stat-row span:last-child {
    color: #fff;
  }

  .chart-panel {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    height: 400px;
    overflow: hidden;
  }

  .chart-header {
    display: flex;
    font-size: 0.7rem;
    color: #666;
    margin-bottom: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid #222;
  }

  .col-token { width: 120px; }
  .col-prob { flex: 1; }

  .chart-bars {
    flex: 1;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding-right: 10px; /* Space for scrollbar */
  }
  
  .chart-bars::-webkit-scrollbar {
    width: 6px;
  }
  .chart-bars::-webkit-scrollbar-track {
    background: #111;
  }
  .chart-bars::-webkit-scrollbar-thumb {
    background: #333;
  }

  /* Dynamically injected bar styles */
  :global(.bar-row) {
    display: flex;
    align-items: center;
    font-size: 0.8rem;
    height: 24px;
    transition: opacity 0.2s;
  }
  
  :global(.bar-row.excluded) {
    opacity: 0.25;
  }
  
  :global(.bar-row.excluded .bar-fill) {
    background: #444 !important;
  }

  :global(.token-name) {
    width: 120px;
    color: #aaa;
    white-space: pre;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  
  :global(.bar-row:not(.excluded) .token-name) {
    color: #fff;
  }

  :global(.bar-track) {
    flex: 1;
    height: 100%;
    background: rgba(255, 255, 255, 0.03);
    position: relative;
    display: flex;
    align-items: center;
  }

  :global(.bar-fill) {
    height: 60%;
    background: #3bceac; /* Cyan */
    transition: width 0.3s ease;
    min-width: 1px;
  }

  :global(.prob-label) {
    margin-left: 10px;
    font-size: 0.75rem;
    color: #888;
    position: absolute;
    left: 100%;
  }
</style>

<script>
  // Dry and isolated logic inside a Web Component
  class SamplerWidget extends HTMLElement {
    constructor() {
      super();
      this.mode = this.dataset.mode || 'all';
      this.datasetName = this.dataset.dataset || 'uncertain';
      
      // Elements
      this.sliders = {
        t: this.querySelector('#slider-t'),
        k: this.querySelector('#slider-k'),
        p: this.querySelector('#slider-p'),
        minp: this.querySelector('#slider-minp')
      };
      
      this.displays = {
        t: this.querySelector('#val-t'),
        k: this.querySelector('#val-k'),
        p: this.querySelector('#val-p'),
        minp: this.querySelector('#val-minp')
      };
      
      this.chartBars = this.querySelector('#chart-bars');
      this.statKept = this.querySelector('#stat-kept');
      this.statMass = this.querySelector('#stat-mass');

      this.initData();
      this.setupMode();
      this.bindEvents();
      this.render();
    }

    initData() {
      // Generate synthetic but realistic logits
      this.tokens = [];
      
      if (this.datasetName === 'confident') {
        const topTokens = [
          { t: ' AL', z: 15.0 },
          { t: ' A', z: 13.0 },
          { t: ' J', z: 12.0 },
          { t: ' Al', z: 11.5 }
        ];
        this.tokens.push(...topTokens);
        // Generate long tail
        for (let i = 0; i < 46; i++) {
          this.tokens.push({
            t: ` token_${i}`,
            z: 8.0 - (i * 0.3) + (Math.random() * 0.5)
          });
        }
      } else {
        // Uncertain (flatter distribution)
        const topTokens = [
          { t: ' towering', z: 12.5 },
          { t: ' smoke', z: 12.2 },
          { t: ' cobbled', z: 12.0 },
          { t: ' dark', z: 11.8 },
          { t: ' bustling', z: 11.5 },
          { t: ' stone', z: 11.4 },
          { t: ' rain', z: 11.1 },
          { t: ' distant', z: 11.0 },
          { t: ' the', z: 10.5 },
          { t: ' winding', z: 10.2 }
        ];
        this.tokens.push(...topTokens);
        for (let i = 0; i < 40; i++) {
          this.tokens.push({
            t: ` token_${i}`,
            z: 9.0 - (i * 0.2) + (Math.random() * 0.3)
          });
        }
      }
      
      // Sort initial logits descending
      this.tokens.sort((a, b) => b.z - a.z);
    }

    setupMode() {
      const disable = (param) => {
        const el = this.querySelector(`[data-param="${param}"]`);
        if (el) el.classList.add('disabled');
      };

      // Set initial values based on mode to highlight specific effects
      if (this.mode === 'temperature') {
        disable('top-k');
        disable('top-p');
        disable('min-p');
      } else if (this.mode === 'top-k') {
        this.sliders.k.value = 10;
        disable('top-p');
        disable('min-p');
      } else if (this.mode === 'top-p') {
        this.sliders.p.value = 0.90;
        disable('top-k');
        disable('min-p');
      } else if (this.mode === 'min-p') {
        this.sliders.minp.value = 0.10;
        this.sliders.t.value = 2.0; // Min-P shows best at higher temp
        disable('top-k');
        disable('top-p');
      }
      
      // Update displays to match initial values
      for (const [key, slider] of Object.entries(this.sliders)) {
        this.displays[key].textContent = parseFloat(slider.value).toFixed(slider.step.includes('.') ? 2 : 0);
      }
    }

    bindEvents() {
      for (const [key, slider] of Object.entries(this.sliders)) {
        slider.addEventListener('input', (e) => {
          this.displays[key].textContent = parseFloat(e.target.value).toFixed(slider.step.includes('.') ? 2 : 0);
          this.render();
        });
      }
    }

    computeProbabilities() {
      const T = parseFloat(this.sliders.t.value);
      const K = parseInt(this.sliders.k.value);
      const P = parseFloat(this.sliders.p.value);
      const MinP = parseFloat(this.sliders.minp.value);

      // 1. Apply Temperature and get base probabilities
      let sumExp = 0;
      let data = this.tokens.map(tok => {
        const expZ = Math.exp(tok.z / T);
        sumExp += expZ;
        return { ...tok, expZ };
      });
      
      data.forEach(tok => {
        tok.baseProb = tok.expZ / sumExp;
        tok.kept = true; // Assume kept initially
      });

      // Sort by base probability descending
      data.sort((a, b) => b.baseProb - a.baseProb);

      // 2. Apply Top-K
      if (this.mode === 'top-k' || this.mode === 'all') {
        data.forEach((tok, idx) => {
          if (idx >= K) tok.kept = false;
        });
      }

      // 3. Apply Top-P
      if (this.mode === 'top-p' || this.mode === 'all') {
        let cumSum = 0;
        data.forEach(tok => {
          if (!tok.kept) return;
          cumSum += tok.baseProb;
          // Keep token if cumSum *before* adding this token was < P
          // Wait, standard top-p keeps tokens until cumSum >= P. 
          // So if cumSum - tok.baseProb > P, it is dropped.
          if (cumSum - tok.baseProb > P + 1e-9) { // tiny epsilon for float math
            tok.kept = false;
          }
        });
        // Ensure at least 1 token is kept (argmax)
        let anyKept = data.some(t => t.kept);
        if (!anyKept && data.length > 0) data[0].kept = true;
      }

      // 4. Apply Min-P
      if (this.mode === 'min-p' || this.mode === 'all') {
        const maxProb = data[0].baseProb;
        const threshold = MinP * maxProb;
        data.forEach(tok => {
          if (tok.baseProb < threshold) tok.kept = false;
        });
      }

      // 5. Renormalize kept tokens
      let keptSum = 0;
      data.forEach(tok => {
        if (tok.kept) keptSum += tok.baseProb;
      });

      data.forEach(tok => {
        tok.finalProb = tok.kept ? (tok.baseProb / keptSum) : 0;
      });

      return { data, keptSum };
    }

    render() {
      const { data, keptSum } = this.computeProbabilities();
      
      // Calculate stats
      const keptCount = data.filter(t => t.kept).length;
      this.statKept.textContent = `${keptCount}/${data.length}`;
      this.statMass.textContent = `${(keptSum * 100).toFixed(2)}%`;

      // Render bars
      this.chartBars.innerHTML = '';
      
      // Find max probability for scaling the bars visually (so the largest is always ~100% width of the chart)
      const maxFinalProb = Math.max(...data.map(t => t.finalProb));
      const visualScale = maxFinalProb > 0 ? 1 / maxFinalProb : 1;

      data.forEach(tok => {
        const row = document.createElement('div');
        row.className = `bar-row ${tok.kept ? '' : 'excluded'}`;
        
        const tokenName = document.createElement('div');
        tokenName.className = 'token-name';
        tokenName.textContent = tok.t.replace(/ /g, '·'); // Make spaces visible
        
        const track = document.createElement('div');
        track.className = 'bar-track';
        
        const fill = document.createElement('div');
        fill.className = 'bar-fill';
        // Visually scale relative to max probability for better chart legibility, 
        // but label with actual probability.
        // Actually, scaling absolute is better for showing temperature flattening.
        // Let's use absolute scale: 100% width = 100% probability
        const pct = (tok.finalProb * 100).toFixed(1);
        const basePct = (tok.baseProb * 100).toFixed(1);
        
        // Use base probability width if excluded, to show what was cut
        const displayWidth = tok.kept ? pct : basePct;
        fill.style.width = `${Math.min(displayWidth, 100)}%`;
        
        const label = document.createElement('div');
        label.className = 'prob-label';
        label.textContent = tok.kept ? `${pct}%` : `(${basePct}%)`;
        if (tok.kept && pct > 80) {
           label.style.left = 'auto';
           label.style.right = '5px';
           label.style.color = '#000'; // contrast
           fill.style.position = 'relative';
           fill.appendChild(label);
        } else {
           track.appendChild(label);
        }

        track.appendChild(fill);
        row.appendChild(tokenName);
        row.appendChild(track);
        
        this.chartBars.appendChild(row);
      });
    }
  }

  customElements.define('sampler-widget', SamplerWidget);
</script>
